{
    "name": "cube-illustrations",
    "version": "0.1.0",
    "description": "Reusable animated WebGPU cube illustration scenes for React",
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./sdk": {
            "types": "./dist/sdk/index.d.ts",
            "import": "./dist/sdk/index.js"
        },
        "./styles.css": "./dist/styles.css"
    },
    "scripts": {
        "demo": "vite --config config/vite.demo.config.ts",
        "build": "vite build --config config/vite.config.ts && tsc -p config/tsconfig.build.json",
        "prepare": "npm run build",
        "check": "npm run check:types && npm run test && npm run build",
        "check:types": "tsc -p tsconfig.json --noEmit",
        "lint": "npm run lint:format && npm run lint:structure && npm run lint:aliases && npm run lint:gallery && npm run lint:js && npm run lint:css",
        "lint:format": "prettier --config config/lint/.prettierrc --check . --log-level warn --ignore-path config/lint/.prettierignore",
        "lint:structure": "node config/lint/check.structure.js --strict",
        "lint:aliases": "node config/lint/check.aliases.js",
        "lint:gallery": "node config/lint/check.gallery.js",
        "lint:js": "eslint --config config/lint/eslint.config.mjs src tests demo config",
        "lint:css": "stylelint \"src/**/*.css\" --config config/lint/stylelint.config.cjs --ignore-path config/lint/.stylelintignore",
        "fix": "npm run fix:format && npm run fix:js && npm run fix:css",
        "fix:format": "prettier --config config/lint/.prettierrc --write . --log-level warn --ignore-path config/lint/.prettierignore",
        "fix:js": "eslint --config config/lint/eslint.config.mjs src tests demo config --fix",
        "fix:css": "stylelint \"src/**/*.css\" --fix --config config/lint/stylelint.config.cjs --ignore-path config/lint/.stylelintignore",
        "test": "vitest run --config config/vitest.config.ts",
        "pack:check": "npm pack --dry-run"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "peerDependencies": {
        "react": ">=18.2.0",
        "react-dom": ">=18.2.0",
        "three": ">=0.185.0"
    },
    "devDependencies": {
        "@eslint-react/eslint-plugin": "^5.18.6",
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@types/three": "^0.185.3",
        "@vitejs/plugin-react": "^6.0.5",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-n": "^18.3.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-unicorn": "^73.0.0",
        "globals": "^17.11.0",
        "jsdom": "^28.1.0",
        "prettier": "^3.9.6",
        "prettier-plugin-css-order": "^2.2.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "stylelint": "^17.14.1",
        "stylelint-config-standard": "^40.0.0",
        "three": "^0.185.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.68.0",
        "vite": "^8.2.0",
        "vitest": "^4.1.10"
    },
    "license": "ISC"
}
